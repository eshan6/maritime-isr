# Copy this file to `.env` at the repo root and fill in what you have.
# `.env` is gitignored — never commit real keys.
#
# On Windows, from the repo root in PowerShell:
#     Copy-Item .env.example .env
# then open .env in Notepad and paste your keys in.

# ---------------------------------------------------------------------
# Core paths / mode
# ---------------------------------------------------------------------
MISR_DATA_ROOT=./data
# local  -> read and write local disk only   (CORRECT FOR LAPTOP MODE)
# r2     -> read Cloudflare R2 only          (needs a deploy host)
# mirror -> local for recent, R2 for durable (needs a deploy host)
MISR_STORE_BACKEND=local

# ---------------------------------------------------------------------
# NEEDED NOW — download-only laptop mode
# ---------------------------------------------------------------------
# Global Fishing Watch. Free; register at globalfishingwatch.org/our-apis
# and generate an API token. Powers the events connectors (encounters,
# loitering, port visits, AIS gaps) and vessel identity.
GFW_API_TOKEN=

# ---------------------------------------------------------------------
# PARKED — not needed until a deploy host exists.
# Leave these blank. `maritime-isr doctor` reports their absence as fine.
# ---------------------------------------------------------------------

# Cloudflare R2 object storage — parked, no bucket provisioned.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=maritime-isr-raw

# Copernicus Data Space. Parked: only needed to DOWNLOAD SAR imagery.
# The scene-catalog metadata search we use needs no login at all.
CDSE_USERNAME=
CDSE_PASSWORD=

# aisstream.io live AIS. Parked: it is a live websocket feed and needs a
# machine that stays on. A laptop cannot hold this open.
AISSTREAM_API_KEY=
